{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@repo/ui": ["../../packages/ui/src/index.ts"],
      "@repo/ui/*": ["../../packages/ui/src/*"],
      "@repo/types": ["../../packages/types/src/index.ts"],
      "@repo/config": ["../../packages/config/src/index.ts"],
      "@repo/shared": ["../../packages/shared/src/index.ts"],
      "@repo/utils": ["../../packages/utils/src/index.ts"],
      "@repo/validation": ["../../packages/validation/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "../../packages/ui/src/**/*.ts",
    "../../packages/ui/src/**/*.tsx",
    "../../packages/config/src/**/*.ts",
    "../../packages/types/src/**/*.ts",
    "../../packages/shared/src/**/*.ts",
    "../../packages/shared/src/**/*.tsx",
    "../../packages/utils/src/**/*.ts",
    "../../packages/validation/src/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
